// stdlib/string.luon — String operations for Luon WASI runtime
// Functions: strlen, strcmp, memcpy, itoa, atoi
// Correct v2 syntax — verified against parser patterns


∀ₛₚₑ𝒸 Ψ ∈ 𝔘[string] ⊢_Γ {

  // strlen(ptr) → length
  // acc = ptr, returns count of non-zero bytes
  ∃!Φ ∈ Hom(𝒞,𝒟)[strlen] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
    (∂_Ω ⊗_ℤ 0)^{⊗L}_{D(𝔄)}
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
    ⊢_{Γ}^{⊃I}⟦
      μ_{ω₁}^{CK}⟦
        // addr = ptr + offset
        (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, σ₃))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₁₀)^{seq}
        // load byte
        (σ₁₀ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (⊩_{𝕂,Σ}^{Γ-generic} ↤₈_𝒯 ∂_Ω)
        // if zero, exit
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
        // count++
        (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
        (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
      ⟧_{ω₁}^{CK}μ
    ⟧^{⊃E}_{Δ}⊣
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // strcmp(a_ptr, b_ptr) → 0 if equal
  // acc = a_ptr, σ₂ = b_ptr (set by caller before call)
  ∃!Φ ∈ Hom(𝒞,𝒟)[strcmp] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
    ⊢_{Γ}^{⊃I}⟦
      μ_{ω₁}^{CK}⟦
        // Load byte from a
        (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (⊩_{𝕂,Σ}^{Γ-generic} ↤₈_𝒯 ∂_Ω)
        (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
        // Load byte from b
        (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (⊩_{𝕂,Σ}^{Γ-generic} ↤₈_𝒯 ∂_Ω)
        (∂_Ω ⊢_{Γ;Δ} σ₅)^{seq}
        // If a[i] != b[i]: compute diff, exit
        (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, σ₅))_{Spec ℤ}
        // Actually: diff = a - b, but Add pattern used for Sub needs workaround
        // Check if a[i] == 0 (end of string)
        (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
        // Advance pointers
        (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
        (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
        (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
      ⟧_{ω₁}^{CK}μ
    ⟧^{⊃E}_{Δ}⊣
    // Return a[i] - b[i] (0 if equal)
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Tor₀^𝔄(∂_Ω, -σ₅))_{Spec ℤ}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // memcpy(dst, src, len) → dst
  // acc = dst, σ₂ = src (caller sets), σ₃ = len (caller sets via σ₃ register)
  ∃!Φ ∈ Hom(𝒞,𝒟)[memcpy] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (∂_Ω ⊗_ℤ 0)^{⊗L}_{D(𝔄)}
    (∂_Ω ⊢_{Γ;Δ} σ₅)^{seq}
    ⊢_{Γ}^{⊃I}⟦
      μ_{ω₁}^{CK}⟦
        // if i >= len, exit
        (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Tor₀^𝔄(∂_Ω, -σ₃))_{Spec ℤ}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
        // Load src[i]
        (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, σ₅))_{Spec ℤ}
        (⊩_{𝕂,Σ}^{Γ-generic} ↤₈_𝒯 ∂_Ω)
        (∂_Ω ⊢_{Γ;Δ} σ₆)^{seq}
        // Store to dst[i]
        (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, σ₅))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₇)^{seq}
        (σ₇ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (⊨_{𝕂,Γ}^{κ-forcing} ↦₈_𝒯 σ₆)
        // i++
        (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₅)^{seq}
        (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
      ⟧_{ω₁}^{CK}μ
    ⟧^{⊃E}_{Δ}⊣
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // itoa(value, buf_ptr) → digit count
  // acc = value, σ₂ = output buffer pointer
  // Uses temp buffer at 0xF000 for reverse digits
  ∃!Φ ∈ Hom(𝒞,𝒟)[itoa] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
    (∂_Ω ⊗_ℤ 0)^{⊗L}_{D(𝔄)}
    (∂_Ω ⊢_{Γ;Δ} σ₆)^{seq}
    // temp_buf = 0xF000
    (61440 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    // Extract digits in reverse
    ⊢_{Γ}^{⊃I}⟦
      μ_{ω₁}^{CK}⟦
        (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
        // quotient = value / 10
        (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (RHom_ℤ(10, ∂_Ω))_{D^b(𝔄)}
        (∂_Ω ⊢_{Γ;Δ} σ₅)^{seq}
        // remainder = value % 10 → value - (quotient * 10)
        (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ⊗_ℤ 10)^{⊗L}_{D(𝔄)}
        (∂_Ω ⊢_{Γ;Δ} σ₈)^{seq}
        (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Tor₀^𝔄(∂_Ω, -σ₈))_{Spec ℤ}
        // digit = remainder + '0'
        (Ext⁰_𝔄(∂_Ω, 48))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₈)^{seq}
        // Store digit at temp[idx]
        (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, σ₆))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₉)^{seq}
        (σ₉ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (⊨_{𝕂,Γ}^{κ-forcing} ↦₈_𝒯 σ₈)
        // value = quotient
        (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
        // idx++
        (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₆)^{seq}
        (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
      ⟧_{ω₁}^{CK}μ
    ⟧^{⊃E}_{Δ}⊣
    // Handle zero: if no digits written, write '0'
    (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
    (∂_Ω ⊢_{Γ;Δ} σ₇)^{seq}
    // Reverse copy from temp to output buffer
    (∂_Ω ⊗_ℤ 0)^{⊗L}_{D(𝔄)}
    (∂_Ω ⊢_{Γ;Δ} σ₈)^{seq}
    ⊢_{Γ}^{⊃I}⟦
      μ_{ω₁}^{CK}⟦
        // if i >= len, exit
        (σ₈ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Tor₀^𝔄(∂_Ω, -σ₆))_{Spec ℤ}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
        // Read from temp[len - 1 - i]
        (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Tor₀^𝔄(∂_Ω, -1))_{Spec ℤ}
        (Tor₀^𝔄(∂_Ω, -σ₈))_{Spec ℤ}
        (Ext⁰_𝔄(∂_Ω, σ₄))_{Spec ℤ}
        (⊩_{𝕂,Σ}^{Γ-generic} ↤₈_𝒯 ∂_Ω)
        (∂_Ω ⊢_{Γ;Δ} σ₉)^{seq}
        // Write to out[i]
        (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, σ₈))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₁₀)^{seq}
        (σ₁₀ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (⊨_{𝕂,Γ}^{κ-forcing} ↦₈_𝒯 σ₉)
        // i++
        (σ₈ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₈)^{seq}
        (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
      ⟧_{ω₁}^{CK}μ
    ⟧^{⊃E}_{Δ}⊣
    (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // atoi(ptr) → integer value
  // acc = ptr to null-terminated decimal string
  ∃!Φ ∈ Hom(𝒞,𝒟)[atoi] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
    (∂_Ω ⊗_ℤ 0)^{⊗L}_{D(𝔄)}
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
    ⊢_{Γ}^{⊃I}⟦
      μ_{ω₁}^{CK}⟦
        (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (⊩_{𝕂,Σ}^{Γ-generic} ↤₈_𝒯 ∂_Ω)
        (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
        // if byte == 0, exit
        (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
        // result = result * 10 + (byte - 48)
        (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ⊗_ℤ 10)^{⊗L}_{D(𝔄)}
        (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
        (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Tor₀^𝔄(∂_Ω, -48))_{Spec ℤ}
        (Ext⁰_𝔄(∂_Ω, σ₃))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
        // ptr++
        (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
        (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
      ⟧_{ω₁}^{CK}μ
    ⟧^{⊃E}_{Δ}⊣
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }
}
