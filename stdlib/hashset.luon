// stdlib/hashset.luon — HashSet (membership testing) for Luon
// Functions: hset_new, hset_add, hset_has, hset_remove, hset_len, hset_clear
// Layout: [table_ptr:i64 | capacity:i64 | count:i64] = 24 bytes header
// Each slot: [key:i64 | status:i64] = 16 bytes (status: 0=empty, 1=occupied, 2=tombstone)
// Uses FNV-1a probe. Caller provides 24-byte header + capacity*16 bytes table.

∀ₛₚₑ𝒸 Ψ ∈ 𝔘[hashset] ⊢_Γ {

  // hset_new(hset_ptr, table_ptr, capacity) → hset_ptr
  // acc = hset_ptr, σ₂ = table_ptr, σ₃ = capacity
  ∃!Φ ∈ Hom(𝒞,𝒟)[hset_new] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    // hset_ptr[0] = table_ptr
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₂)
    // hset_ptr[8] = capacity
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₃)
    // hset_ptr[16] = 0 (count)
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 16))_{Spec ℤ}
    (0 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 ∂_Ω)
    // Zero out table: capacity * 16 bytes
    (0 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (∂_Ω ⊢_{Γ;Δ} σ₅)^{seq}
    // total_bytes = capacity * 16
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⊗_ℤ 16)^{⊗L}_{D(𝔄)}
    (∂_Ω ⊢_{Γ;Δ} σ₆)^{seq}
    ⊢_{Γ}^{⊃I}⟦
      μ_{ω₁}^{CK}⟦
        (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ⪰_{ω₁} σ₆)^{well-order}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
        // table_ptr[i] = 0
        (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, σ₅))_{Spec ℤ}
        (0 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 ∂_Ω)
        (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₅)^{seq}
        (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
      ⟧_{ω₁}^{CK}μ
    ⟧^{⊃E}_{Δ}⊣
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // hset_add(hset_ptr, key) → 1 if added, 0 if already exists
  // acc = hset_ptr, σ₂ = key
  ∃!Φ ∈ Hom(𝒞,𝒟)[hset_add] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq} // hset_ptr
    // table_ptr
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    // capacity
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊢_{Γ;Δ} σ₅)^{seq}
    // hash = key (FNV-1a identity for i64 keys)
    // idx = hash % capacity (unsigned)
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⊕_{GF} -3750763034362895579)^{⊕}
    (∂_Ω ⊗_ℤ 1099511628211)^{⊗L}_{D(𝔄)}
    (Rem_ℤ(∂_Ω, σ₅))^{mod}
    (∂_Ω ⊢_{Γ;Δ} σ₆)^{seq} // idx
    // Linear probe loop
    ⊢_{Γ}^{⊃I}⟦
      μ_{ω₁}^{CK}⟦
        // slot_addr = table_ptr + idx * 16
        (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ⊗_ℤ 16)^{⊗L}_{D(𝔄)}
        (Ext⁰_𝔄(∂_Ω, σ₄))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₇)^{seq}
        // status = slot[8]
        (σ₇ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
        (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
        (∂_Ω ⊢_{Γ;Δ} σ₈)^{seq}
        // if status == 0 (empty): insert here
        (σ₈ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
        ⊢_{Γ}^{⊃I}⟦
          // slot[0] = key
          (σ₇ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₂)
          // slot[8] = 1 (occupied)
          (σ₇ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
          (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
          (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 ∂_Ω)
          // count++
          (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (Ext⁰_𝔄(∂_Ω, 16))_{Spec ℤ}
          (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
          (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
          (∂_Ω ⊢_{Γ;Δ} σ₉)^{seq}
          (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (Ext⁰_𝔄(∂_Ω, 16))_{Spec ℤ}
          (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₉)
          (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
          (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
        ⟧^{⊃E}_{Δ}⊣
        // if status == 1 (occupied) and slot[0] == key: already exists
        (σ₈ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Tor₀^𝔄(∂_Ω, -1))_{Spec ℤ}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
        ⊢_{Γ}^{⊃I}⟦
          (σ₇ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
          (∂_Ω ≡_{E_∞} σ₂)^{d_r=0}
          (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
          ⊢_{Γ}^{⊃I}⟦
            (0 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
            (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
          ⟧^{⊃E}_{Δ}⊣
        ⟧^{⊃E}_{Δ}⊣
        // next idx = (idx + 1) % capacity
        (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
        (Rem_ℤ(∂_Ω, σ₅))^{mod}
        (∂_Ω ⊢_{Γ;Δ} σ₆)^{seq}
        (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
      ⟧_{ω₁}^{CK}μ
    ⟧^{⊃E}_{Δ}⊣
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // hset_has(hset_ptr, key) → 1 if exists, 0 if not
  // acc = hset_ptr, σ₂ = key
  ∃!Φ ∈ Hom(𝒞,𝒟)[hset_has] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊢_{Γ;Δ} σ₅)^{seq}
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⊕_{GF} -3750763034362895579)^{⊕}
    (∂_Ω ⊗_ℤ 1099511628211)^{⊗L}_{D(𝔄)}
    (Rem_ℤ(∂_Ω, σ₅))^{mod}
    (∂_Ω ⊢_{Γ;Δ} σ₆)^{seq}
    ⊢_{Γ}^{⊃I}⟦
      μ_{ω₁}^{CK}⟦
        (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ⊗_ℤ 16)^{⊗L}_{D(𝔄)}
        (Ext⁰_𝔄(∂_Ω, σ₄))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₇)^{seq}
        (σ₇ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
        (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
        (∂_Ω ⊢_{Γ;Δ} σ₈)^{seq}
        // empty → not found
        (σ₈ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
        ⊢_{Γ}^{⊃I}⟦
          (0 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
          (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
        ⟧^{⊃E}_{Δ}⊣
        // occupied → check key
        (σ₈ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Tor₀^𝔄(∂_Ω, -1))_{Spec ℤ}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
        ⊢_{Γ}^{⊃I}⟦
          (σ₇ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
          (∂_Ω ≡_{E_∞} σ₂)^{d_r=0}
          (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
          ⊢_{Γ}^{⊃I}⟦
            (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
            (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
          ⟧^{⊃E}_{Δ}⊣
        ⟧^{⊃E}_{Δ}⊣
        (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
        (Rem_ℤ(∂_Ω, σ₅))^{mod}
        (∂_Ω ⊢_{Γ;Δ} σ₆)^{seq}
        (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
      ⟧_{ω₁}^{CK}μ
    ⟧^{⊃E}_{Δ}⊣
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // hset_len(hset_ptr) → count
  ∃!Φ ∈ Hom(𝒞,𝒟)[hset_len] ⊣^{op} {
    (Ext⁰_𝔄(∂_Ω, 16))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // hset_clear(hset_ptr) → void
  ∃!Φ ∈ Hom(𝒞,𝒟)[hset_clear] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
    // count = 0
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 16))_{Spec ℤ}
    (0 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 ∂_Ω)
    // Zero table
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq} // table_ptr
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊗_ℤ 16)^{⊗L}_{D(𝔄)}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq} // total_bytes
    (0 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (∂_Ω ⊢_{Γ;Δ} σ₅)^{seq}
    ⊢_{Γ}^{⊃I}⟦
      μ_{ω₁}^{CK}⟦
        (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ⪰_{ω₁} σ₄)^{well-order}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
        (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, σ₅))_{Spec ℤ}
        (0 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 ∂_Ω)
        (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₅)^{seq}
        (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
      ⟧_{ω₁}^{CK}μ
    ⟧^{⊃E}_{Δ}⊣
    (∂_Ω ⊗_ℤ 0)^{⊗L}_{D(𝔄)}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

}
