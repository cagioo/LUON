// stdlib/slice.luon — Memory slice data structure for Luon
// Functions: slice_new, slice_len, slice_ptr, slice_get, slice_subslice
// Layout: [len:i64 | data_ptr:i64] = 16 bytes header
// Note: Caller provides the 16 bytes slice_ptr to avoid dynamic allocation overhead.

∀ₛₚₑ𝒸 Ψ ∈ 𝔘[slice] ⊢_Γ {

  // slice_new(slice_ptr, data_ptr, len) → slice_ptr
  // acc = slice_ptr, σ₂ = data_ptr, σ₃ = len
  ∃!Φ ∈ Hom(𝒞,𝒟)[slice_new] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq} // save slice_ptr to σ₄
    
    // slice_ptr[0] = len (σ₃)
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₃)
    
    // slice_ptr[8] = data_ptr (σ₂)
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₂)
    
    // return slice_ptr
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // slice_len(slice_ptr) → len
  // acc = slice_ptr
  ∃!Φ ∈ Hom(𝒞,𝒟)[slice_len] ⊣^{op} {
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // slice_ptr(slice_ptr) → data_ptr
  // acc = slice_ptr
  ∃!Φ ∈ Hom(𝒞,𝒟)[slice_ptr] ⊣^{op} {
    (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // slice_get(slice_ptr, idx) → value (or 0 if out of bounds)
  // acc = slice_ptr, σ₂ = idx
  ∃!Φ ∈ Hom(𝒞,𝒟)[slice_get] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq} // save slice_ptr
    
    // len = slice_ptr[0]
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq} // save len
    
    // Check if idx >= len
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⪰_{ω₁} σ₄)^{well-order}
    ⊢_{Γ}^{⊃I}⟦
      (0 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    
    // Check if idx < 0 (using unsigned logic, handled by ⪰ or we assume idx >= 0)
    
    // data_ptr = slice_ptr[8]
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    
    // addr = data_ptr + idx * 8
    (∂_Ω ⊢_{Γ;Δ} σ₅)^{seq}
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⊗_ℤ 8)^{⊗L}_{D(𝔄)}
    (Ext⁰_𝔄(∂_Ω, σ₅))_{Spec ℤ}
    
    // value = *addr
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // slice_subslice(target_slice_ptr, src_slice_ptr, start, end) → target_slice_ptr
  // acc = target_slice_ptr, σ₂ = src_slice_ptr, σ₃ = start, σ₄ = end
  ∃!Φ ∈ Hom(𝒞,𝒟)[slice_subslice] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₅)^{seq} // target_slice_ptr
    
    // Check start < end, otherwise len = 0
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⪰_{ω₁} σ₄)^{well-order}
    ⊢_{Γ}^{⊃I}⟦
      // target_slice_ptr[0] = 0 (len)
      (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
      (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 0)
      (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    
    // len = end - start
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Tor₀^𝔄(∂_Ω, σ₃))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₆)^{seq} // new_len
    
    // src_data_ptr = src_slice_ptr[8]
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    
    // new_data_ptr = src_data_ptr + start * 8
    (∂_Ω ⊢_{Γ;Δ} σ₇)^{seq}
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⊗_ℤ 8)^{⊗L}_{D(𝔄)}
    (Ext⁰_𝔄(∂_Ω, σ₇))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₈)^{seq} // new_data_ptr
    
    // target_slice_ptr[0] = new_len
    (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₆)
    
    // target_slice_ptr[8] = new_data_ptr
    (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₈)
    
    // return target_slice_ptr
    (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

}
