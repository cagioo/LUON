// stdlib/iter.luon — Array/Slice iterator protocol for Luon
// Functions: iter_new, iter_has_next, iter_next
// Layout: [data_ptr:i64 | len:i64 | current_idx:i64] = 24 bytes header
// Note: Caller provides the 24 bytes iter_ptr to avoid dynamic allocation overhead.

∀ₛₚₑ𝒸 Ψ ∈ 𝔘[iter] ⊢_Γ {

  // iter_new(iter_ptr, data_ptr, len) → iter_ptr
  // acc = iter_ptr, σ₂ = data_ptr, σ₃ = len
  ∃!Φ ∈ Hom(𝒞,𝒟)[iter_new] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq} // save iter_ptr
    
    // iter_ptr[0] = data_ptr (σ₂)
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₂)
    
    // iter_ptr[8] = len (σ₃)
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₃)
    
    // iter_ptr[16] = 0 (current_idx)
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 16))_{Spec ℤ}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 0)
    
    // return iter_ptr
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // iter_has_next(iter_ptr) → bool (1/0)
  // acc = iter_ptr
  ∃!Φ ∈ Hom(𝒞,𝒟)[iter_has_next] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq} // save iter_ptr
    
    // len = iter_ptr[8]
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq} // len
    
    // current_idx = iter_ptr[16]
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 16))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    
    // Check if current_idx < len
    (∂_Ω ≺_{ω₁} σ₃)^{well-order}
    ⊢_{Γ}^{⊃I}⟦
      (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    
    (0 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // iter_next(iter_ptr) → val (or 0xFFFFFFFFFFFFFFFE if empty)
  // acc = iter_ptr
  ∃!Φ ∈ Hom(𝒞,𝒟)[iter_next] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq} // save iter_ptr
    
    // len = iter_ptr[8]
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq} // len
    
    // current_idx = iter_ptr[16]
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 16))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq} // current_idx
    
    // Check bounds: if current_idx >= len, return 0xFFFFFFFFFFFFFFFE (-2)
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⪰_{ω₁} σ₃)^{well-order}
    ⊢_{Γ}^{⊃I}⟦
      (18446744073709551614 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    
    // data_ptr = iter_ptr[0]
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊢_{Γ;Δ} σ₅)^{seq} // data_ptr
    
    // addr = data_ptr + current_idx * 8
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⊗_ℤ 8)^{⊗L}_{D(𝔄)}
    (Ext⁰_𝔄(∂_Ω, σ₅))_{Spec ℤ}
    
    // value = *addr
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊢_{Γ;Δ} σ₆)^{seq} // save value
    
    // iter_ptr[16] = current_idx + 1
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₇)^{seq} // next_idx
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 16))_{Spec ℤ}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₇)
    
    // return value
    (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

}
