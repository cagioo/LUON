// stdlib/btreemap.luon — Sorted map (sorted-array B-tree approximation)
// Functions: btm_new, btm_insert, btm_get, btm_len, btm_min, btm_max
// Layout header (24 bytes): [data_ptr:i64 | capacity:i64 | count:i64]
// Each entry (16 bytes): [key:i64 | value:i64] — sorted by key ascending
// Uses insertion sort to maintain order. Caller provides header + capacity*16 bytes.

∀ₛₚₑ𝒸 Ψ ∈ 𝔘[btreemap] ⊢_Γ {

  // btm_new(btm_ptr, data_ptr, capacity) → btm_ptr
  ∃!Φ ∈ Hom(𝒞,𝒟)[btm_new] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₂)
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₃)
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 16))_{Spec ℤ}
    (0 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 ∂_Ω)
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // btm_insert(btm_ptr, key, value) → 1 success, 0 full, 2 updated existing
  // acc=btm_ptr, σ₂=key, σ₃=value
  ∃!Φ ∈ Hom(𝒞,𝒟)[btm_insert] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq} // btm_ptr
    // data_ptr→σ₅, cap→σ₆, count→σ₇
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊢_{Γ;Δ} σ₅)^{seq}
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊢_{Γ;Δ} σ₆)^{seq}
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 16))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊢_{Γ;Δ} σ₇)^{seq}
    // Search for existing key (linear scan)
    (0 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (∂_Ω ⊢_{Γ;Δ} σ₈)^{seq} // i=0
    ⊢_{Γ}^{⊃I}⟦
      μ_{ω₁}^{CK}⟦
        (σ₈ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ⪰_{ω₁} σ₇)^{well-order}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
        // entry_addr = data_ptr + i*16
        (σ₈ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ⊗_ℤ 16)^{⊗L}_{D(𝔄)}
        (Ext⁰_𝔄(∂_Ω, σ₅))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₉)^{seq}
        // if entry[0]==key → update value, return 2
        (σ₉ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
        (∂_Ω ≡_{E_∞} σ₂)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
        ⊢_{Γ}^{⊃I}⟦
          (σ₉ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
          (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₃)
          (2 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
          (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
        ⟧^{⊃E}_{Δ}⊣
        (σ₈ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₈)^{seq}
        (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
      ⟧_{ω₁}^{CK}μ
    ⟧^{⊃E}_{Δ}⊣
    // Key not found — check capacity
    (σ₇ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⪰_{ω₁} σ₆)^{well-order}
    ⊢_{Γ}^{⊃I}⟦
      (0 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    // Find insertion point (where key > existing)
    (σ₇ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⊢_{Γ;Δ} σ₈)^{seq} // insert_pos = count (default: end)
    (0 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (∂_Ω ⊢_{Γ;Δ} σ₉)^{seq} // j=0
    ⊢_{Γ}^{⊃I}⟦
      μ_{ω₁}^{CK}⟦
        (σ₉ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ⪰_{ω₁} σ₇)^{well-order}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
        // if data[j].key > key → insert_pos=j, break
        (σ₉ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ⊗_ℤ 16)^{⊗L}_{D(𝔄)}
        (Ext⁰_𝔄(∂_Ω, σ₅))_{Spec ℤ}
        (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
        (∂_Ω ≻_{E₂^{p,q}} σ₂)^{filtration}
        ⊢_{Γ}^{⊃I}⟦
          (σ₉ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (∂_Ω ⊢_{Γ;Δ} σ₈)^{seq}
          (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
        ⟧^{⊃E}_{Δ}⊣
        (σ₉ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₉)^{seq}
        (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
      ⟧_{ω₁}^{CK}μ
    ⟧^{⊃E}_{Δ}⊣
    // Shift elements right from count-1 down to insert_pos
    (σ₇ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⊢_{Γ;Δ} σ₉)^{seq} // k = count
    ⊢_{Γ}^{⊃I}⟦
      μ_{ω₁}^{CK}⟦
        (σ₉ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ≡_{E_∞} σ₈)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
        ⊢_{Γ}^{⊃I}⟦
          (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
        ⟧^{⊃E}_{Δ}⊣
        // k_prev = k - 1
        (σ₉ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Tor₀^𝔄(∂_Ω, -1))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₁₀)^{seq}
        // src = data_ptr + k_prev*16
        (σ₁₀ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ⊗_ℤ 16)^{⊗L}_{D(𝔄)}
        (Ext⁰_𝔄(∂_Ω, σ₅))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₁₁)^{seq}
        // dst = data_ptr + k*16
        (σ₉ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ⊗_ℤ 16)^{⊗L}_{D(𝔄)}
        (Ext⁰_𝔄(∂_Ω, σ₅))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₁₂)^{seq}
        // dst[0]=src[0], dst[8]=src[8]
        (σ₁₁ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
        (∂_Ω ⊢_{Γ;Δ} σ₁₃)^{seq}
        (σ₁₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₁₃)
        (σ₁₁ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
        (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
        (∂_Ω ⊢_{Γ;Δ} σ₁₃)^{seq}
        (σ₁₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
        (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₁₃)
        // k = k_prev
        (σ₁₀ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ⊢_{Γ;Δ} σ₉)^{seq}
        (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
      ⟧_{ω₁}^{CK}μ
    ⟧^{⊃E}_{Δ}⊣
    // Write new entry at insert_pos
    (σ₈ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⊗_ℤ 16)^{⊗L}_{D(𝔄)}
    (Ext⁰_𝔄(∂_Ω, σ₅))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₉)^{seq}
    (σ₉ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₂)
    (σ₉ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₃)
    // count += 1
    (σ₇ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₁₀)^{seq}
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 16))_{Spec ℤ}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₁₀)
    (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // btm_get(btm_ptr, key) → value (or 0 if not found)
  ∃!Φ ∈ Hom(𝒞,𝒟)[btm_get] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq} // data_ptr
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 16))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊢_{Γ;Δ} σ₅)^{seq} // count
    (0 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (∂_Ω ⊢_{Γ;Δ} σ₆)^{seq}
    ⊢_{Γ}^{⊃I}⟦
      μ_{ω₁}^{CK}⟦
        (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ⪰_{ω₁} σ₅)^{well-order}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
        (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ⊗_ℤ 16)^{⊗L}_{D(𝔄)}
        (Ext⁰_𝔄(∂_Ω, σ₄))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₇)^{seq}
        (σ₇ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
        (∂_Ω ≡_{E_∞} σ₂)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
        ⊢_{Γ}^{⊃I}⟦
          (σ₇ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
          (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
          (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
        ⟧^{⊃E}_{Δ}⊣
        (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₆)^{seq}
        (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
      ⟧_{ω₁}^{CK}μ
    ⟧^{⊃E}_{Δ}⊣
    (0 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // btm_len(btm_ptr) → count
  ∃!Φ ∈ Hom(𝒞,𝒟)[btm_len] ⊣^{op} {
    (Ext⁰_𝔄(∂_Ω, 16))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // btm_min(btm_ptr) → key of first entry (or 0 if empty)
  ∃!Φ ∈ Hom(𝒞,𝒟)[btm_min] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 16))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
    ⊢_{Γ}^{⊃I}⟦
      (0 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // btm_max(btm_ptr) → key of last entry (or 0 if empty)
  ∃!Φ ∈ Hom(𝒞,𝒟)[btm_max] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 16))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
    ⊢_{Γ}^{⊃I}⟦
      (0 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    // addr = data_ptr + (count-1)*16
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 16))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (Tor₀^𝔄(∂_Ω, -1))_{Spec ℤ}
    (∂_Ω ⊗_ℤ 16)^{⊗L}_{D(𝔄)}
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (Ext⁰_𝔄(∂_Ω, σ₃))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

}
