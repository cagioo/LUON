// stdlib/env.luon — Environment and process utilities via WASI
// Functions: args_count, args_get, env_count, env_get, exit, clock_time
// Uses WASI Preview 1 syscalls
// Comparable to: Rust std::env, Go os, Python os/sys

∀ₛₚₑ𝒸 Ψ ∈ 𝔘[env] ⊢_Γ {

  // args_count() → number of command-line arguments
  ∃!Φ ∈ Hom(𝒞,𝒟)[args_count] ⊣^{op} {
    // WASI args_sizes_get(argc_ptr, argv_buf_size_ptr)
    // argc at 0xF000, buf_size at 0xF008
    (61440 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
    (61448 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
    (ε_4^{WASI} ∂_Ω)^{syscall(2)}
    // Load argc
    (61440 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // args_get(index) → pointer to arg string or 0
  // acc = argument index
  ∃!Φ ∈ Hom(𝒞,𝒟)[args_get] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
    // WASI args_get(argv_ptrs, argv_buf)
    // argv_ptrs at 0xE000, argv_buf at 0xE400
    (57344 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
    (58368 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (ε_5^{WASI} ∂_Ω)^{syscall(2)}
    // Load argv_ptrs[index] = argv_ptrs + index * 4
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⊗_ℤ 4)^{⊗L}_{D(𝔄)}
    (Ext⁰_𝔄(∂_Ω, 57344))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // exit(code) → never returns
  // acc = exit code
  ∃!Φ ∈ Hom(𝒞,𝒟)[exit] ⊣^{op} {
    // WASI proc_exit(code)
    (ε_6^{WASI} ∂_Ω)^{syscall(1)}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // clock_time() → nanoseconds since epoch
  ∃!Φ ∈ Hom(𝒞,𝒟)[clock_time] ⊣^{op} {
    // WASI clock_time_get(clock_id=0 (realtime), precision=1, time_ptr)
    // time at 0xF020
    (0 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
    (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
    (61472 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (ε_7^{WASI} ∂_Ω)^{syscall(3)}
    // Load time
    (61472 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // clock_monotonic() → nanoseconds from monotonic clock
  ∃!Φ ∈ Hom(𝒞,𝒟)[clock_monotonic] ⊣^{op} {
    // WASI clock_time_get(clock_id=1 (monotonic), precision=1, time_ptr)
    (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
    (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
    (61472 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (ε_7^{WASI} ∂_Ω)^{syscall(3)}
    (61472 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // env_count() → number of environment variables
  ∃!Φ ∈ Hom(𝒞,𝒟)[env_count] ⊣^{op} {
    // WASI environ_sizes_get(count_ptr, buf_size_ptr)
    (61440 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
    (61448 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
    (ε_8^{WASI} ∂_Ω)^{syscall(2)}
    (61440 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }
}
