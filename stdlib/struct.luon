// stdlib/struct.luon — Struct/Record type support for Luon
// Provides runtime support for user-defined composite types.
//
// Struct Descriptor Table at 0x56000:
//   [name_hash:i64 | field_count:i64 | total_size:i64 | fields_ptr:i64] = 32 bytes
// Field Descriptor:
//   [name_hash:i64 | type_id:i64 | offset:i64 | size:i64] = 32 bytes
//
// Syntax for struct declaration:
//   ∃!Ξ ∈ 𝔖[struct_name] ⊢_{Γ} {
//     (field_name : type_id)
//     ...
//   }
//
// Comparable to: Rust struct, Go struct, C struct, TypeScript interface

∀ₛₚₑ𝒸 Ψ ∈ 𝔘[struct] ⊢_Γ {

  // struct_define(name_hash, field_count) → struct_descriptor_ptr
  // acc = name_hash, σ₂ = field_count
  ∃!Φ ∈ Hom(𝒞,𝒟)[struct_define] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
    // Allocate descriptor: 32 bytes header + field_count * 32 bytes
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⊗_ℤ 32)^{⊗L}_{D(𝔄)}
    (Ext⁰_𝔄(∂_Ω, 32))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    // Bump alloc
    (∂_Ω ⊗_ℤ 0)^{⊗L}_{D(𝔄)}
    (Ext⁰_𝔄(∂_Ω, 327680))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊢_{Γ;Δ} σ₅)^{seq}
    (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, σ₄))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₆)^{seq}
    (∂_Ω ⊗_ℤ 0)^{⊗L}_{D(𝔄)}
    (Ext⁰_𝔄(∂_Ω, 327680))_{Spec ℤ}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₆)
    // Store name_hash
    (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₃)
    // Store field_count
    (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₇)^{seq}
    (σ₇ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₂)
    // Store total_size = 0 (computed after fields added)
    (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 16))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₇)^{seq}
    (σ₇ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 0)
    // Store fields_ptr = descriptor + 32
    (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 24))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₇)^{seq}
    (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 32))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₈)^{seq}
    (σ₇ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₈)
    // Return descriptor ptr
    (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // struct_add_field(desc_ptr, field_index, name_hash, type_id, size) → offset
  // acc = desc_ptr, σ₂ = field_index, σ₃ = name_hash, σ₄ = type_id, σ₅ = size
  ∃!Φ ∈ Hom(𝒞,𝒟)[struct_add_field] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₆)^{seq}
    // Load fields_ptr
    (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 24))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊢_{Γ;Δ} σ₇)^{seq}
    // field_addr = fields_ptr + field_index * 32
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⊗_ℤ 32)^{⊗L}_{D(𝔄)}
    (Ext⁰_𝔄(∂_Ω, σ₇))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₈)^{seq}
    // Load current total_size as offset
    (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 16))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊢_{Γ;Δ} σ₉)^{seq}
    // Store field: name_hash
    (σ₈ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₃)
    // Store field: type_id
    (σ₈ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₁₀)^{seq}
    (σ₁₀ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₄)
    // Store field: offset
    (σ₈ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 16))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₁₀)^{seq}
    (σ₁₀ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₉)
    // Store field: size
    (σ₈ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 24))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₁₀)^{seq}
    (σ₁₀ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₅)
    // Update total_size += size
    (σ₉ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, σ₅))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₁₁)^{seq}
    (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 16))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₁₀)^{seq}
    (σ₁₀ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₁₁)
    // Return offset
    (σ₉ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // struct_new(desc_ptr) → instance_ptr
  // Allocates a new instance of the struct
  // acc = desc_ptr
  ∃!Φ ∈ Hom(𝒞,𝒟)[struct_new] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
    // Load total_size
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 16))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
    // Bump alloc
    (∂_Ω ⊗_ℤ 0)^{⊗L}_{D(𝔄)}
    (Ext⁰_𝔄(∂_Ω, 327680))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, σ₃))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₅)^{seq}
    (∂_Ω ⊗_ℤ 0)^{⊗L}_{D(𝔄)}
    (Ext⁰_𝔄(∂_Ω, 327680))_{Spec ℤ}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₅)
    // Zero-initialize
    (∂_Ω ⊗_ℤ 0)^{⊗L}_{D(𝔄)}
    (∂_Ω ⊢_{Γ;Δ} σ₆)^{seq}
    ⊢_{Γ}^{⊃I}⟦
      μ_{ω₁}^{CK}⟦
        (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ⪰_{ω₁} σ₃)^{well-order}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
        (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, σ₆))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₇)^{seq}
        (σ₇ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (⊨_{𝕂,Γ}^{κ-forcing} ↦₈_𝒯 0)
        (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₆)^{seq}
        (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
      ⟧_{ω₁}^{CK}μ
    ⟧^{⊃E}_{Δ}⊣
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // struct_get_field(instance_ptr, offset) → field value
  // acc = instance_ptr, σ₂ = field offset
  ∃!Φ ∈ Hom(𝒞,𝒟)[struct_get_field] ⊣^{op} {
    (Ext⁰_𝔄(∂_Ω, σ₂))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // struct_set_field(instance_ptr, offset, value) → value
  // acc = instance_ptr, σ₂ = field offset, σ₃ = value
  ∃!Φ ∈ Hom(𝒞,𝒟)[struct_set_field] ⊣^{op} {
    (Ext⁰_𝔄(∂_Ω, σ₂))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₃)
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // struct_size(desc_ptr) → total byte size
  // acc = desc_ptr
  ∃!Φ ∈ Hom(𝒞,𝒟)[struct_size] ⊣^{op} {
    (Ext⁰_𝔄(∂_Ω, 16))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }
}
