{
  "name": "luon-language",
  "displayName": "Luon Language",
  "description": "Syntax highlighting, snippets, and language support for the Luon programming language — Vesege Ecosystem",
  "version": "0.2.0",
  "publisher": "vesege-institute",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/cagioo/LUON"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters"
  ],
  "keywords": [
    "luon",
    "vesege",
    "wasm",
    "webassembly",
    "blockchain",
    "systems-programming"
  ],
  "contributes": {
    "languages": [
      {
        "id": "luon",
        "aliases": [
          "Luon",
          "luon",
          "LUON"
        ],
        "extensions": [
          ".luon"
        ],
        "configuration": "./language-configuration.json",
        "firstLine": "^//.*luon"
      }
    ],
    "grammars": [
      {
        "language": "luon",
        "scopeName": "source.luon",
        "path": "./syntaxes/luon.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "luon",
        "path": "./snippets/luon.json"
      }
    ]
  },
  "private": true,
  "license": "Apache-2.0"
}
