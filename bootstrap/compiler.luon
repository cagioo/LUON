        (σ₂₀ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₂₀)^{seq}
        (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
      ⟧_{ω₁}^{CK}μ
    ⟧^{⊃E}_{Δ}⊣
    
    // Return final size = mem[48] - 196608
    (48 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (Tor₀^𝔄(∂_Ω, -196608))_{Spec ℤ}
    
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }
}
