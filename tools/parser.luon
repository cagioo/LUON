// tools/parser.luon — Native Luon v2 EXTREME Parser

∀ₛₚₑ𝒸 Ψ ∈ 𝔘[parser] ⊢_Γ {

  // scan_line(pos, end) → line_end_pos
  ∃!Φ ∈ Hom(𝒞,𝒟)[scan_line] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
    (32 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
    ⊢_{Γ}^{⊃I}⟦
      μ_{ω₁}^{CK}⟦
        (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Tor₀^𝔄(∂_Ω, -σ₂))_{Spec ℤ}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
        
        (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (⊩_{𝕂,Σ}^{Γ-generic} ↤₈_𝒯 ∂_Ω)
        (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
        
        (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Tor₀^𝔄(∂_Ω, -10))_{Spec ℤ}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
        
        (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
        (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
      ⟧_{ω₁}^{CK}μ
    ⟧^{⊃E}_{Δ}⊣
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // hash_line(pos, len) → FNV-1a hash
  ∃!Φ ∈ Hom(𝒞,𝒟)[hash_line] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq} // pos
    (40 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq} // len
    (-3750763034362895579 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq} // hash
    ⊢_{Γ}^{⊃I}⟦
      μ_{ω₁}^{CK}⟦
        (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule} // break if len == 0
        
        ⊢_{Γ}^{⊃I}⟦ // CONTINUE BLOCK
          // byte = src[pos]
          (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (⊩_{𝕂,Σ}^{Γ-generic} ↤₈_𝒯 ∂_Ω)
          (∂_Ω ⊢_{Γ;Δ} σ₆)^{seq}
          
          // if b >= 48 && b <= 57: continue
          (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (Tor₀^𝔄(∂_Ω, -48))_{Spec ℤ}
          (∂_Ω ⊢_{Γ;Δ} σ₇)^{seq}
          (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (Tor₀^𝔄(∂_Ω, -58))_{Spec ℤ}
          (∂_Ω ⊢_{Γ;Δ} σ₈)^{seq}
          (σ₇ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (∂_Ω ≽_{E₂^{p,q}} 0)^{⊇filt}
          (∂_Ω ⊢_{Γ;Δ} σ₉)^{seq}
          (σ₈ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (∂_Ω ≺_{E₂^{p,q}} 0)^{filtration}
          (∂_Ω ∧_{𝔹} σ₉)^{∧}
          (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule}

          // if b == 45 ('-') or b == 32 (' ') or b == 95 ('_'): continue
          (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (Tor₀^𝔄(∂_Ω, -45))_{Spec ℤ}
          (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
          (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule}
          (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (Tor₀^𝔄(∂_Ω, -32))_{Spec ℤ}
          (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
          (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule}
          (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (Tor₀^𝔄(∂_Ω, -95))_{Spec ℤ}
          (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
          (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule}

          // if b == 0xCF && next == 0x83 ('σ'): skip 2 bytes
          (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (Tor₀^𝔄(∂_Ω, -207))_{Spec ℤ}
          (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
          (∂_Ω ⊢_{Γ;Δ} σ₉)^{seq}
          (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
          (⊩_{𝕂,Σ}^{Γ-generic} ↤₈_𝒯 ∂_Ω)
          (Tor₀^𝔄(∂_Ω, -131))_{Spec ℤ}
          (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
          (∂_Ω ∧_{𝔹} σ₉)^{∧}
          ⊢_{Γ}^{⊃I}⟦
            (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
            (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
            // skip 1 extra byte (since loop increments by 1)
            (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
            (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
            (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
            (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
            (Tor₀^𝔄(∂_Ω, -1))_{Spec ℤ}
            (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
            (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
            (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule} // break out of continue block
          ⟧^{⊃E}_{Δ}⊣

          // skip subscript digits (e2 82 8x)
          (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (Tor₀^𝔄(∂_Ω, -226))_{Spec ℤ} // 0xE2
          (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
          ⊢_{Γ}^{⊃I}⟦
            (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
            (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
            // skip 2 extra bytes
            (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
            (Ext⁰_𝔄(∂_Ω, 2))_{Spec ℤ}
            (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
            (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
            (Tor₀^𝔄(∂_Ω, -2))_{Spec ℤ}
            (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
            (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
            (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
          ⟧^{⊃E}_{Δ}⊣

          // Compute FNV-1a hash
          (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (∂_Ω ⊕_{GF} σ₆)^{⊕}
          (∂_Ω ⊗_ℤ 1099511628211)^{⊗L}_{D(𝔄)}
          (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
        ⟧^{⊃E}_{Δ}⊣ // END CONTINUE BLOCK
        
        // len -= 1, pos += 1
        (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Tor₀^𝔄(∂_Ω, -1))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
        (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
        (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
      ⟧_{ω₁}^{CK}μ
    ⟧^{⊃E}_{Δ}⊣
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // dispatch(hash) -> opcode
  ∃!Φ ∈ Hom(𝒞,𝒟)[dispatch] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq} // hash
    ⊢_{Γ}^{⊃I}⟦
      ⊢_{Γ}^{⊃I}⟦
        (4833215907409249767 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ≡_{E_∞} σ₃)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic} // eqz (1 if !=)
        (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule} // break if !=
        (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule} // break out of outer block
      ⟧^{⊃E}_{Δ}⊣
      ⊢_{Γ}^{⊃I}⟦
        (8762512685794832560 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ≡_{E_∞} σ₃)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic} // eqz (1 if !=)
        (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule} // break if !=
        (2 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule} // break out of outer block
      ⟧^{⊃E}_{Δ}⊣
      ⊢_{Γ}^{⊃I}⟦
        (-2784534727670731454 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ≡_{E_∞} σ₃)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic} // eqz (1 if !=)
        (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule} // break if !=
        (3 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule} // break out of outer block
      ⟧^{⊃E}_{Δ}⊣
      ⊢_{Γ}^{⊃I}⟦
        (5543789437107753232 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ≡_{E_∞} σ₃)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic} // eqz (1 if !=)
        (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule} // break if !=
        (4 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule} // break out of outer block
      ⟧^{⊃E}_{Δ}⊣
      ⊢_{Γ}^{⊃I}⟦
        (3939632832870425310 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ≡_{E_∞} σ₃)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic} // eqz (1 if !=)
        (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule} // break if !=
        (5 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule} // break out of outer block
      ⟧^{⊃E}_{Δ}⊣
      ⊢_{Γ}^{⊃I}⟦
        (-3650645065449768652 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ≡_{E_∞} σ₃)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic} // eqz (1 if !=)
        (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule} // break if !=
        (6 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule} // break out of outer block
      ⟧^{⊃E}_{Δ}⊣
      ⊢_{Γ}^{⊃I}⟦
        (413348630739906644 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ≡_{E_∞} σ₃)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic} // eqz (1 if !=)
        (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule} // break if !=
        (7 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule} // break out of outer block
      ⟧^{⊃E}_{Δ}⊣
      ⊢_{Γ}^{⊃I}⟦
        (3303469312732886956 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ≡_{E_∞} σ₃)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic} // eqz (1 if !=)
        (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule} // break if !=
        (8 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule} // break out of outer block
      ⟧^{⊃E}_{Δ}⊣
      ⊢_{Γ}^{⊃I}⟦
        (-4026857797746187518 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ≡_{E_∞} σ₃)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic} // eqz (1 if !=)
        (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule} // break if !=
        (9 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule} // break out of outer block
      ⟧^{⊃E}_{Δ}⊣
      ⊢_{Γ}^{⊃I}⟦
        (-8113203991206144865 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ≡_{E_∞} σ₃)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic} // eqz (1 if !=)
        (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule} // break if !=
        (10 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule} // break out of outer block
      ⟧^{⊃E}_{Δ}⊣
      ⊢_{Γ}^{⊃I}⟦
        (-6475713459959600021 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ≡_{E_∞} σ₃)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic} // eqz (1 if !=)
        (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule} // break if !=
        (11 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule} // break out of outer block
      ⟧^{⊃E}_{Δ}⊣
      ⊢_{Γ}^{⊃I}⟦
        (-539121932313425026 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ≡_{E_∞} σ₃)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic} // eqz (1 if !=)
        (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule} // break if !=
        (12 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule} // break out of outer block
      ⟧^{⊃E}_{Δ}⊣
      ⊢_{Γ}^{⊃I}⟦
        (-1085189396117621213 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ≡_{E_∞} σ₃)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic} // eqz (1 if !=)
        (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule} // break if !=
        (13 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule} // break out of outer block
      ⟧^{⊃E}_{Δ}⊣
      ⊢_{Γ}^{⊃I}⟦
        (-5171738221532938838 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ≡_{E_∞} σ₃)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic} // eqz (1 if !=)
        (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule} // break if !=
        (14 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule} // break out of outer block
      ⟧^{⊃E}_{Δ}⊣
      ⊢_{Γ}^{⊃I}⟦
        (4287841857904033994 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ≡_{E_∞} σ₃)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic} // eqz (1 if !=)
        (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule} // break if !=
        (15 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule} // break out of outer block
      ⟧^{⊃E}_{Δ}⊣
      ⊢_{Γ}^{⊃I}⟦
        (-4011855909282216650 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ≡_{E_∞} σ₃)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic} // eqz (1 if !=)
        (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule} // break if !=
        (16 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule} // break out of outer block
      ⟧^{⊃E}_{Δ}⊣
      ⊢_{Γ}^{⊃I}⟦
        (-6638848135805562770 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ≡_{E_∞} σ₃)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic} // eqz (1 if !=)
        (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule} // break if !=
        (17 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule} // break out of outer block
      ⟧^{⊃E}_{Δ}⊣
      ⊢_{Γ}^{⊃I}⟦
        (-2932152336338573210 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ≡_{E_∞} σ₃)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic} // eqz (1 if !=)
        (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule} // break if !=
        (18 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule} // break out of outer block
      ⟧^{⊃E}_{Δ}⊣
      ⊢_{Γ}^{⊃I}⟦
        (-4126939922252157059 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ≡_{E_∞} σ₃)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic} // eqz (1 if !=)
        (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule} // break if !=
        (19 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule} // break out of outer block
      ⟧^{⊃E}_{Δ}⊣
      ⊢_{Γ}^{⊃I}⟦
        (-2737667341852033621 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ≡_{E_∞} σ₃)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic} // eqz (1 if !=)
        (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule} // break if !=
        (20 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule} // break out of outer block
      ⟧^{⊃E}_{Δ}⊣
      ⊢_{Γ}^{⊃I}⟦
        (5600705030278784824 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ≡_{E_∞} σ₃)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic} // eqz (1 if !=)
        (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule} // break if !=
        (21 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule} // break out of outer block
      ⟧^{⊃E}_{Δ}⊣
      ⊢_{Γ}^{⊃I}⟦
        (466850259500057285 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ≡_{E_∞} σ₃)^{d_r=0}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic} // eqz (1 if !=)
        (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule} // break if !=
        (22 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule} // break out of outer block
      ⟧^{⊃E}_{Δ}⊣
      ⊢_{Γ}^{⊃I}⟦
        (6358117769997184277 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        (∂_Ω ≡_{E_∞} σ₃)^{d_r=0}
