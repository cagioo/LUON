// tools/typechecker.luon — Static type checker foundation for Luon
// Defines the compile-time type model used by the Luon toolchain.
// This is the first production-grade semantic phase after parsing.
//
// Type IDs:
//   0 void
//   1 bool
//   2 i32
//   3 i64
//   4 f32
//   5 f64
//   6 ptr
//   7 str
//   8 array
//   9 struct
//   10 fn
//   11 result
//   12 option
//   13 never
//   14 i8
//   15 i16
//   16 u8
//   17 u16
//   18 u32
//   19 u64
//
// Type descriptor layout at TYPE_TABLE_BASE (0x54000):
//   [kind:i64 | size:i64 | align:i64 | param0:i64 | param1:i64 | name_hash:i64]
// Each descriptor = 48 bytes

∀ₛₚₑ𝒸 Ψ ∈ 𝔘[typechecker] ⊢_Γ {

  // type_size(type_id) → byte size
  // acc = type_id
  ∃!Φ ∈ Hom(𝒞,𝒟)[type_size] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
    // Built-in sizes by type id
    // void=0, bool=1, i8/u8=1, i16/u16=2, i32/u32/f32=4,
    // i64/u64/f64/ptr/fn handles=8, str/result/option descriptors=16
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
    ⊢_{Γ}^{⊃I}⟦
      (0 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 1)^{acyclic}
    ⊢_{Γ}^{⊃I}⟦
      (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 2)^{acyclic}
    ⊢_{Γ}^{⊃I}⟦
      (4 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 4)^{acyclic}
    ⊢_{Γ}^{⊃I}⟦
      (4 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    // str/result/option descriptors are 16 bytes
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 7)^{acyclic}
    ⊢_{Γ}^{⊃I}⟦
      (16 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 11)^{acyclic}
    ⊢_{Γ}^{⊃I}⟦
      (16 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 12)^{acyclic}
    ⊢_{Γ}^{⊃I}⟦
      (16 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    // i8/u8 are 1 byte
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 14)^{acyclic}
    ⊢_{Γ}^{⊃I}⟦
      (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 16)^{acyclic}
    ⊢_{Γ}^{⊃I}⟦
      (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    // i16/u16 are 2 bytes
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 15)^{acyclic}
    ⊢_{Γ}^{⊃I}⟦
      (2 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 17)^{acyclic}
    ⊢_{Γ}^{⊃I}⟦
      (2 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    // u32 is 4 bytes
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 18)^{acyclic}
    ⊢_{Γ}^{⊃I}⟦
      (4 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    // default 8 bytes for i64/u64/f64/ptr/fn/handles
    (8 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // type_align(type_id) → alignment
  // acc = type_id
  ∃!Φ ∈ Hom(𝒞,𝒟)[type_align] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
    // bool/i8/u8 alignment 1
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 1)^{acyclic}
    ⊢_{Γ}^{⊃I}⟦
      (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 14)^{acyclic}
    ⊢_{Γ}^{⊃I}⟦
      (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 16)^{acyclic}
    ⊢_{Γ}^{⊃I}⟦
      (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    // i16/u16 alignment 2
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 15)^{acyclic}
    ⊢_{Γ}^{⊃I}⟦
      (2 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 17)^{acyclic}
    ⊢_{Γ}^{⊃I}⟦
      (2 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    // i32/u32/f32 alignment 4
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 2)^{acyclic}
    ⊢_{Γ}^{⊃I}⟦
      (4 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 4)^{acyclic}
    ⊢_{Γ}^{⊃I}⟦
      (4 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 18)^{acyclic}
    ⊢_{Γ}^{⊃I}⟦
      (4 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    // default 8
    (8 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // type_is_numeric(type_id) → 1 if numeric
  // acc = type_id
  ∃!Φ ∈ Hom(𝒞,𝒟)[type_is_numeric] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
    // numeric if 2 <= type_id <= 5 OR 14 <= type_id <= 19
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⪰_{ω₁} 2)^{well-order}
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⪯_{ω₁} 5)^{well-order}
    (∂_Ω ∧_{Bool} σ₃)^{∧-intro}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⪰_{ω₁} 14)^{well-order}
    (∂_Ω ⊢_{Γ;Δ} σ₅)^{seq}
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⪯_{ω₁} 19)^{well-order}
    (∂_Ω ∧_{Bool} σ₅)^{∧-intro}
    (∂_Ω ∨_{Bool} σ₄)^{∨-intro}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // type_can_assign(dst_type, src_type) → 1 if assignment is legal
  // acc = dst_type, σ₂ = src_type
  ∃!Φ ∈ Hom(𝒞,𝒟)[type_can_assign] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
    // Exact match always legal
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} σ₂)^{acyclic}
    ⊢_{Γ}^{⊃I}⟦
      (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    // i32 -> i64 widening
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 3)^{acyclic}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 2)^{acyclic}
    (∂_Ω ∧_{Bool} σ₄)^{∧-intro}
    ⊢_{Γ}^{⊃I}⟦
      (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    // f32 -> f64 widening
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 5)^{acyclic}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 4)^{acyclic}
    (∂_Ω ∧_{Bool} σ₄)^{∧-intro}
    ⊢_{Γ}^{⊃I}⟦
      (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    // signed integer widening: i8 -> i16/i32/i64
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 15)^{acyclic}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 2)^{acyclic}
    (∂_Ω ∨_{Bool} σ₄)^{∨-intro}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 3)^{acyclic}
    (∂_Ω ∨_{Bool} σ₄)^{∨-intro}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 14)^{acyclic}
    (∂_Ω ∧_{Bool} σ₄)^{∧-intro}
    ⊢_{Γ}^{⊃I}⟦
      (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    // signed integer widening: i16 -> i32/i64
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 2)^{acyclic}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 3)^{acyclic}
    (∂_Ω ∨_{Bool} σ₄)^{∨-intro}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 15)^{acyclic}
    (∂_Ω ∧_{Bool} σ₄)^{∧-intro}
    ⊢_{Γ}^{⊃I}⟦
      (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    // unsigned integer widening: u8 -> u16/u32/u64
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 17)^{acyclic}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 18)^{acyclic}
    (∂_Ω ∨_{Bool} σ₄)^{∨-intro}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 19)^{acyclic}
    (∂_Ω ∨_{Bool} σ₄)^{∨-intro}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 16)^{acyclic}
    (∂_Ω ∧_{Bool} σ₄)^{∧-intro}
    ⊢_{Γ}^{⊃I}⟦
      (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    // unsigned integer widening: u16 -> u32/u64
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 18)^{acyclic}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 19)^{acyclic}
    (∂_Ω ∨_{Bool} σ₄)^{∨-intro}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 17)^{acyclic}
    (∂_Ω ∧_{Bool} σ₄)^{∧-intro}
    ⊢_{Γ}^{⊃I}⟦
      (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    // unsigned integer widening: u32 -> u64
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 18)^{acyclic}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 19)^{acyclic}
    (∂_Ω ∧_{Bool} σ₄)^{∧-intro}
    ⊢_{Γ}^{⊃I}⟦
      (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
      ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    ⟧^{⊃E}_{Δ}⊣
    // otherwise false
    (0 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // type_is_signed_integer(type_id) → 1 if signed integer
  // acc = type_id
  ∃!Φ ∈ Hom(𝒞,𝒟)[type_is_signed_integer] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 14)^{acyclic}
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 15)^{acyclic}
    (∂_Ω ∨_{Bool} σ₃)^{∨-intro}
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 2)^{acyclic}
    (∂_Ω ∨_{Bool} σ₃)^{∨-intro}
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 3)^{acyclic}
    (∂_Ω ∨_{Bool} σ₃)^{∨-intro}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // type_is_unsigned_integer(type_id) → 1 if unsigned integer
  // acc = type_id
  ∃!Φ ∈ Hom(𝒞,𝒟)[type_is_unsigned_integer] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⪰_{ω₁} 16)^{well-order}
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⪯_{ω₁} 19)^{well-order}
    (∂_Ω ∧_{Bool} σ₃)^{∧-intro}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // type_is_integer(type_id) → 1 if signed or unsigned integer
  // acc = type_id
  ∃!Φ ∈ Hom(𝒞,𝒟)[type_is_integer] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⪰_{ω₁} 14)^{well-order}
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⪯_{ω₁} 19)^{well-order}
    (∂_Ω ∧_{Bool} σ₃)^{∧-intro}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 2)^{acyclic}
    (∂_Ω ∨_{Bool} σ₄)^{∨-intro}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ≡_{E_∞} 3)^{acyclic}
    (∂_Ω ∨_{Bool} σ₄)^{∨-intro}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  // type_error(code, line, col) → error record ptr
  // acc = error code, σ₂ = line, σ₃ = column
  // Error layout: [code | line | col | severity] = 32 bytes
  ∃!Φ ∈ Hom(𝒞,𝒟)[type_error] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    // allocate 32 bytes from heap
    (∂_Ω ⊗_ℤ 0)^{⊗L}_{D(𝔄)}
    (Ext⁰_𝔄(∂_Ω, 327680))_{Spec ℤ}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
    (∂_Ω ⊢_{Γ;Δ} σ₅)^{seq}
    (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 32))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₆)^{seq}
    (∂_Ω ⊗_ℤ 0)^{⊗L}_{D(𝔄)}
    (Ext⁰_𝔄(∂_Ω, 327680))_{Spec ℤ}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₆)
    // code
    (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₄)
    // line
    (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 8))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₇)^{seq}
    (σ₇ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₂)
    // col
    (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 16))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₇)^{seq}
    (σ₇ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₃)
    // severity = 2 (error)
    (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 24))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₇)^{seq}
    (σ₇ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 2)
    (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }
}
