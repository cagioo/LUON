∀ₛₚₑ𝒸 Ψ ∈ 𝔘[main] ⊢_Γ {
// fibonacci.luon — Compute Fibonacci(N) iteratively
// Input: arg = N, Output: Fibonacci(N)
// σ2=prev, σ3=curr, σ4=counter
∃!Φ ∈ Hom(𝒞,𝒟)[fibonacci] ⊣^{op} {
  ∃!Φ ∈ Hom(𝒞,𝒟)[main] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    (0 ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
    (1 ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
    ⊢_{Γ}^{⊃I}⟦
    μ_{ω₁}^{CK}⟦
      (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
      (∂_Ω ≼_{E₂^{p,q}} 1)^{⊆filt}
      (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
      (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
      (∂_Ω ⊢_{Γ;Δ} σ₅)^{seq}
      (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
      (Ext⁰_𝔄(∂_Ω, σ₂))_{Spec ℤ}
      (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
      (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
      (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
      (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
      (Tor₀^𝔄(∂_Ω, -1))_{Spec ℤ}
      (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
      (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
    ⟧_{ω₁}^{CK}μ
    ⟧^{⊃E}_{Δ}⊣
    (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }
}

}