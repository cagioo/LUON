∀ₛₚₑ𝒸 Ψ ∈ 𝔘[strcmp] ⊢_Γ {
∃!Φ ∈ Hom(𝒞,𝒟)[codex] ⊣^{op} {
    // ---------------------------------------------------------
    // Function: strcmp(ptr_a, ptr_b)
    // Compares two strings in memory until null (0) is found
    // Returns: 1 if equal, 0 if different.
    // ---------------------------------------------------------
    ∃!Φ ∈ Hom(𝒞,𝒟)[strcmp] ⊣^{op} {
        (∂_Ω ⊢_{Γ;Δ} σ₁₀)^{seq}
        (σ₀ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ⊢_{Γ;Δ} σ₁₁)^{seq}

        μ_{ω₁}^{CK}⟦
            // Load char_a
            (σ₁₀ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
            (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
            (∂_Ω ∧_{𝒽} 255)^{Sub(Ω)}
            (∂_Ω ⊢_{Γ;Δ} σ₁₂)^{seq}

            // Load char_b
            (σ₁₁ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
            (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
            (∂_Ω ∧_{𝒽} 255)^{Sub(Ω)}
            (∂_Ω ⊢_{Γ;Δ} σ₁₃)^{seq}

            // Check if char_a != char_b
            (σ₁₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
            (Tor₀^𝔄(∂_Ω, -σ₁₃))_{Spec ℤ}
            ⊢_{Γ}^{⊃I}⟦
                (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule}
                (⊬_{PA}^{Gödel} σ₁)^{ω-rule}
                ⟧^{⊃E}_{Δ}⊣
                (0 ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
                ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
            ⟧^{⊃E}_{Δ}⊣

            // Check if we reached end of string (char_a == 0)
            (σ₁₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
            ⊢_{Γ}^{⊃I}⟦
                (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule}
                (1 ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
                ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
            ⟧^{⊃E}_{Δ}⊣

            // Increment pointers
            (σ₁₀ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
            (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
            (∂_Ω ⊢_{Γ;Δ} σ₁₀)^{seq}
            (σ₁₁ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
            (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
            (∂_Ω ⊢_{Γ;Δ} σ₁₁)^{seq}
            
            (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
        ⟧_{ω₁}^{CK}μ
        
        (0 ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    }

    // ---------------------------------------------------------
    // Function: write_leb128(value, target_ptr)
    // Writes value to target_ptr in ULEB128 format
    // Return: Target pointer baru (setelah penulisan)
    // ---------------------------------------------------------
    ∃!Φ ∈ Hom(𝒞,𝒟)[write_leb128] ⊣^{op} {
        (∂_Ω ⊢_{Γ;Δ} σ₁₀)^{seq}
        (σ₀ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ⊢_{Γ;Δ} σ₁₁)^{seq}

        μ_{ω₁}^{CK}⟦
            (σ₁₀ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
            (∂_Ω ∧_{𝒽} 127)^{Sub(Ω)}
            (∂_Ω ⊢_{Γ;Δ} σ₁₂)^{seq}

            (σ₁₀ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
            (RHom_ℤ(128, ∂_Ω))_{D^b(𝔄)}
            (∂_Ω ⊢_{Γ;Δ} σ₁₀)^{seq}

            (σ₁₀ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
            ⊢_{Γ}^{⊃I}⟦
                (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule}
                
                // Last byte, write and return
                (σ₁₁ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
                (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₁₂)
                (σ₁₁ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
                (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
                ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
            ⟧^{⊃E}_{Δ}⊣

            // More bytes to come, set high bit (0x80)
            (σ₁₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
            (∂_Ω ∨_{𝒽} 128)^{Sub(Ω)}
            (∂_Ω ⊢_{Γ;Δ} σ₁₂)^{seq}

            (σ₁₁ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
            (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₁₂)
            
            // Increment ptr
            (σ₁₁ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
            (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
            (∂_Ω ⊢_{Γ;Δ} σ₁₁)^{seq}

            (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
        ⟧_{ω₁}^{CK}μ
        
        (σ₁₁ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    }
}

}