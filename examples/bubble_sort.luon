∀ₛₚₑ𝒸 Ψ ∈ 𝔘[main] ⊢_Γ {
// bubble_sort.luon — Sort 5 bytes in memory using bubble sort
// Input: pre-loaded bytes at mem[1000..1005]
// Output: smallest byte value (mem[1000] after sort)
// Registers: σ2=outer_i, σ3=inner_j, σ4=addr_j, σ5=val_j, σ6=val_j1, σ7=temp
∃!Φ ∈ Hom(𝒞,𝒟)[bubble_sort] ⊣^{op} {
  ∃!Φ ∈ Hom(𝒞,𝒟)[main] ⊣^{op} {
    (1000 ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⊢_{Γ;Δ} σ₁₀)^{seq}
    (5 ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⊢_{Γ;Δ} σ₁₁)^{seq}
    (0 ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
    μ_{ω₁}^{CK}⟦
      (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
      (∂_Ω ≺_{E₂^{p,q}} σ₁₁)^{filtration}
      (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
      (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
      (0 ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
      (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
      (σ₁₁ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
      (Tor₀^𝔄(∂_Ω, -1))_{Spec ℤ}
      (Tor₀^𝔄(∂_Ω, -σ₂))_{Spec ℤ}
      (∂_Ω ⊢_{Γ;Δ} σ₈)^{seq}
      μ_{ω₁}^{CK}⟦
        (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ≺_{E₂^{p,q}} σ₈)^{filtration}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
        (σ₁₀ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, σ₃))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
        (⊩_{𝕂,Σ}^{Γ-generic} ↤₈_𝒯 ∂_Ω)
        (∂_Ω ⊢_{Γ;Δ} σ₅)^{seq}
        (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₉)^{seq}
        (⊩_{𝕂,Σ}^{Γ-generic} ↤₈_𝒯 ∂_Ω)
        (∂_Ω ⊢_{Γ;Δ} σ₆)^{seq}
        (σ₅ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ≻_{E₂^{p,q}} σ₆)^{cofiltration}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
        ⊢_{Γ}^{⊃I}⟦
          (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule}
          (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (∂_Ω ⊢_{Γ;Δ} σ₇)^{seq}
          (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (⊨_{𝕂,Γ}^{κ-forcing} ↦₈_𝒯 σ₆)
          (σ₉ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (⊨_{𝕂,Γ}^{κ-forcing} ↦₈_𝒯 σ₅)
        ⟧^{⊃E}_{Δ}⊣
        (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
        (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
        (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
      ⟧_{ω₁}^{CK}μ
      (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
      (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
      (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
      (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
    ⟧_{ω₁}^{CK}μ
    (σ₁₀ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (⊩_{𝕂,Σ}^{Γ-generic} ↤₈_𝒯 ∂_Ω)
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }
}

}