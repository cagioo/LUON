∀ₛₚₑ𝒸 Ψ ∈ 𝔘[main] ⊢_Γ {
∃!Φ ∈ Hom(𝒞,𝒟)[test_cmp] ⊣^{op} {
    ∃!Φ ∈ Hom(𝒞,𝒟)[main] ⊣^{op} {
        (σ₀ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        ⊢_{Γ}^{⊃I}⟦
            (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule}
            (0 ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
            ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
        ⟧^{⊃E}_{Δ}⊣
        (1 ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    }
}

}