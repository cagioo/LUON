∀ₛₚₑ𝒸 Ψ ∈ 𝔘[pow_test] ⊢_Γ {
  ∃!Φ ∈ Hom(𝒞,𝒟)[pow] ⊣^{op} {
    (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
    (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
    (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
    ⊢_{Γ}^{⊃I}⟦
      μ_{ω₁}^{CK}⟦
        (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
        (∂_Ω ⊬_{PA}^{Gödel} σ₁)^{ω-rule}
        
        (1 ⊣_{Δ;Γ} ∂_Ω)^{axiom}
        ⊢_{Γ}^{⊃I}⟦
          (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (∂_Ω ∧_{𝔹} 1)^{∧-intro}
          (∂_Ω ≡_{E_∞} ⊥)^{acyclic}
          (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule}
          (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
          (∂_Ω ⊗_ℤ σ₃)^{⊗L}_{D(𝔄)}
          (∂_Ω ⊢_{Γ;Δ} σ₄)^{seq}
        ⟧^{⊃E}_{Δ}⊣
        (σ₃ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ⊗_ℤ σ₃)^{⊗L}_{D(𝔄)}
        (∂_Ω ⊢_{Γ;Δ} σ₃)^{seq}
        (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (∂_Ω ≫_{shift} 1)^{shift}
        (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
        (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
      ⟧_{ω₁}^{CK}μ
    ⟧^{⊃E}_{Δ}⊣
    (σ₄ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  ∃!Φ ∈ Hom(𝒞,𝒟)[main] ⊣^{op} {
    // pow(base=4, exp=3) → 4^3 = 64
    // σ₂ = exponent, acc = base
    (3 ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
    (4 ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    η_{Kan}[pow]
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }
}
