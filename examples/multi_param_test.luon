∀ₛₚₑ𝒸 Ψ ∈ 𝔘[multi_param] ⊢_Γ {
  ∃!Φ ∈ Hom(𝒞,𝒟)[add2](σ₂) ⊣^{op} {
    (σ₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 0))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₁)^{seq}
    (σ₁ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (Ext⁰_𝔄(∂_Ω, 0))_{Spec ℤ}
    (∂_Ω ⊢_{Γ;Δ} σ₀)^{seq}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }

  ∃!Φ ∈ Hom(𝒞,𝒟)[main] ⊣^{op} {
    (10 ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
    (20 ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    η_{Kan}0
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }
}
