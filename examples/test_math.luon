  (⊢_{Γ}^{import} 𝔘[math])

  ∃!Φ ∈ Hom(𝒞,𝒟)[main] ⊣^{op} {
    // test pow(3, 4) = 81
    (4 ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
    (3 ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    η_{Kan}[pow]
    (∂_Ω ⊢_{Γ;Δ} σ₆)^{seq}

    // test sqrt(100) = 10
    (100 ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    η_{Kan}[sqrt]
    (∂_Ω ⊢_{Γ;Δ} σ₇)^{seq}

    // test gcd(48, 18) = 6
    (18 ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω ⊢_{Γ;Δ} σ₂)^{seq}
    (48 ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    η_{Kan}[gcd]
    (∂_Ω ⊢_{Γ;Δ} σ₈)^{seq}

    // Return sum: 81 + 10 + 6 = 97
    (σ₆ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
    (∂_Ω Ext⁰_{Spec} σ₇)^{Ext⁰}
    (∂_Ω Ext⁰_{Spec} σ₈)^{Ext⁰}
    ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
  }
