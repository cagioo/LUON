∀ₛₚₑ𝒸 Ψ ∈ 𝔘[main] ⊢_Γ {
∃!Φ ∈ Hom(𝒞,𝒟)[test_leb] ⊣^{op} {
    ∃!Φ ∈ Hom(𝒞,𝒟)[main] ⊣^{op} {
        (0 ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 131072)

        (σ₀ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (η_σ₁ ∘_{2-Cat} ∂_Ω)^{Kan}
        
        (0 ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
        (Tor₀^𝔄(∂_Ω, -131072))_{Spec ℤ}
        ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    }

    ∃!Φ ∈ Hom(𝒞,𝒟)[write_leb128] ⊣^{op} {
        (∂_Ω ⊢_{Γ;Δ} σ₁₀)^{seq}
        (0 ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        (⊩_{𝕂,Σ}^{Γ-generic} ↤_𝒯 ∂_Ω)
        (∂_Ω ⊢_{Γ;Δ} σ₁₁)^{seq}

        μ_{ω₁}^{CK}⟦
            (σ₁₀ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
            (∂_Ω ∧_{𝒽} 127)^{Sub(Ω)}
            (∂_Ω ⊢_{Γ;Δ} σ₁₂)^{seq}

            (σ₁₀ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
            (RHom_ℤ(128, ∂_Ω))_{D^b(𝔄)}
            (∂_Ω ⊢_{Γ;Δ} σ₁₀)^{seq}

            (σ₁₀ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
            ⊢_{Γ}^{⊃I}⟦
                (∂_Ω ⊬_{PA}^{Gödel} σ₀)^{ω-rule}
                
                // value == 0 (Last byte)
                (σ₁₁ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
                (⊨_{𝕂,Γ}^{κ-forcing} ↦₈_𝒯 σ₁₂)
                (σ₁₁ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
                (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
                (∂_Ω ⊢_{Γ;Δ} σ₁₁)^{seq}
                (0 ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
                (⊨_{𝕂,Γ}^{κ-forcing} ↦_𝒯 σ₁₁)
                (σ₁₁ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
                ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
            ⟧^{⊃E}_{Δ}⊣

            // value > 0 (More bytes)
            (σ₁₂ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
            (∂_Ω ∨_{𝒽} 128)^{Sub(Ω)}
            (∂_Ω ⊢_{Γ;Δ} σ₁₂)^{seq}
            (σ₁₁ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
            (⊨_{𝕂,Γ}^{κ-forcing} ↦₈_𝒯 σ₁₂)
            (σ₁₁ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
            (Ext⁰_𝔄(∂_Ω, 1))_{Spec ℤ}
            (∂_Ω ⊢_{Γ;Δ} σ₁₁)^{seq}

            (⊬_{PA}^{Gödel} σ₀)^{ω-rule}
        ⟧_{ω₁}^{CK}μ
        (σ₁₁ ⊣_{Δ;Γ} ∂_Ω)^{co-seq}
        ⊥_{𝒯}→^{ex falso}⊤_{𝒯}
    }
}

}